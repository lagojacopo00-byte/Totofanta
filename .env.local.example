# Copia questo file in .env.local e riempi i valori presi dal tuo progetto Supabase
# (Project Settings -> API).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Solo lato server, non esporre mai al browser: serve alle pagine dei
# giocatori (che non hanno un login Supabase, ma un link personale) per
# leggere/scrivere sul torneo dopo aver verificato il loro token.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Solo lato server. Token gratuito da football-data.org (piano free
# registrato: 10 richieste/minuto) — serve al creator per sincronizzare
# data/ora e risultati reali di Serie A da /dashboard/fixtures invece di
# inserirli a mano. Gli esiti del piano gratuito arrivano con circa un
# giorno di ritardo (non sono "live"); gli orari invece sono sempre
# aggiornati. Senza questa variabile il bottone "Sincronizza ora"
# fallisce con un errore esplicito.
FOOTBALL_API_KEY=
